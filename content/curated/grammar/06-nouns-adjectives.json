  "lessons": [
    {
      "id": "gramnoun.articles",
      "title": "Mạo từ a, an, the",
      "summary": "Khi nào dùng a/an, the hay không dùng gì.",
      "level": "A1_2",
      "minutes": 6,
      "blocks": [
        {
          "type": "text",
          "md": "- **a/an**: một (lần đầu nhắc, chưa xác định). **an** trước âm nguyên âm: *an apple, an hour*.\n- **the**: đã xác định (cả người nói và người nghe đều biết), duy nhất (*the sun*), so sánh nhất (*the best*).\n- **không dùng mạo từ**: danh từ số nhiều/không đếm được nói chung (*I like music*), tên người, bữa ăn, ngôn ngữ."
        },
        {
          "type": "table",
          "head": [
            "Trường hợp",
            "Ví dụ"
          ],
          "rows": [
            [
              "Nhắc lần đầu",
              "I saw a dog."
            ],
            [
              "Nhắc lại",
              "The dog was big."
            ],
            [
              "Duy nhất",
              "The sun is hot."
            ],
            [
              "Nói chung",
              "Dogs are friendly."
            ],
            [
              "Bữa ăn / môn học",
              "We have lunch at noon."
            ]
          ]
        },
        {
          "type": "examples",
          "items": [
            {
              "en": "She is an engineer and he is a teacher.",
              "vi": "Cô ấy là kỹ sư còn anh ấy là giáo viên."
            },
            {
              "en": "Close the door, please.",
              "vi": "Làm ơn đóng cửa lại."
            },
            {
              "en": "I love music, but I don’t play the piano.",
              "vi": "Tôi yêu âm nhạc nhưng không chơi piano."
            }
          ]
        },
        {
          "type": "tip",
          "md": "Chơi nhạc cụ dùng **the** (*play the guitar*), chơi thể thao thì không (*play football*)."
        }
      ],
      "exercises": [
        {
          "type": "gap",
          "prompt": "I have ___ orange in my bag.",
          "answers": [
            "an"
          ],
          "choices": [
            "an",
            "a",
            "the"
          ],
          "explain": "Orange bắt đầu bằng nguyên âm → an."
        },
        {
          "type": "gap",
          "prompt": "___ sun rises in the east.",
          "answers": [
            "The"
          ],
          "choices": [
            "The",
            "A",
            "An"
          ]
        },
        {
          "type": "gap",
          "prompt": "She plays ___ guitar very well.",
          "answers": [
            "the"
          ],
          "choices": [
            "the",
            "a",
            "an"
          ]
        },
        {
          "type": "gap",
          "prompt": "We usually have ___ breakfast at seven.",
          "answers": [
            "-",
            "no article",
            "x"
          ],
          "choices": [
            "the",
            "a",
            "-"
          ],
          "explain": "Bữa ăn không dùng mạo từ."
        },
        {
          "type": "mcq",
          "prompt": "Which is correct?",
          "choices": [
            "He is a honest man.",
            "He is an honest man.",
            "He is the honest man always."
          ],
          "answer": 1,
          "explain": "Honest đọc /ˈɒnɪst/, âm h câm → an."
        },
        {
          "type": "order",
          "hint": "Tôi nhìn thấy một con chó. Con chó rất to.",
          "answer": "I saw a dog The dog was big"
        }
      ]
    },
    {
      "id": "gramnoun.plurals",
      "title": "Danh từ số nhiều",
      "summary": "Quy tắc -s, -es, -ies và các dạng bất quy tắc.",
      "level": "A1_1",
      "minutes": 5,
      "blocks": [
        {
          "type": "text",
          "md": "- Thông thường thêm **-s**: *book → books*.\n- Tận cùng **s, x, z, ch, sh** thêm **-es**: *box → boxes*, *watch → watches*.\n- Tận cùng **phụ âm + y** đổi **y → ies**: *baby → babies*.\n- Tận cùng **-f/-fe** thường đổi thành **-ves**: *leaf → leaves*, *knife → knives*.\n- **Bất quy tắc**: man → men, woman → women, child → children, foot → feet, tooth → teeth, person → people, mouse → mice."
        },
        {
          "type": "table",
          "head": [
            "Số ít",
            "Số nhiều"
          ],
          "rows": [
            [
              "book",
              "books"
            ],
            [
              "box",
              "boxes"
            ],
            [
              "baby",
              "babies"
            ],
            [
              "leaf",
              "leaves"
            ],
            [
              "child",
              "children"
            ],
            [
              "foot",
              "feet"
            ],
            [
              "person",
              "people"
            ],
            [
              "sheep",
              "sheep"
            ]
          ]
        },
        {
          "type": "examples",
          "items": [
            {
              "en": "There are three children in the garden.",
              "vi": "Có ba đứa trẻ trong vườn."
            },
            {
              "en": "These boxes are heavy.",
              "vi": "Những cái hộp này nặng."
            },
            {
              "en": "Many people like pizza.",
              "vi": "Nhiều người thích pizza."
            }
          ]
        },
        {
          "type": "tip",
          "md": "**People** đã là số nhiều (*people are*), không thêm -s. **Sheep, fish** giữ nguyên ở số nhiều."
        }
      ],
      "exercises": [
