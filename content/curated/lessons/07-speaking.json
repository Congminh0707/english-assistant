  "lessons": [
    {
      "id": "speak.introductions",
      "title": "Nói: giới thiệu bản thân",
      "summary": "Đọc to các câu chào hỏi và giới thiệu đầu tiên.",
      "level": "A1_1",
      "minutes": 8,
      "blocks": [
        {
          "type": "text",
          "md": "Bài này luyện **nói thành tiếng**. Bấm 🎤, đọc to câu hiện trên màn hình, app sẽ nghe và chấm từng từ (chạy offline trên máy bạn). Mẹo: nói chậm, rõ từng từ, đặt micro gần miệng."
        },
        {
          "type": "examples",
          "items": [
            {
              "en": "Hello, my name is Lan.",
              "vi": "Xin chào, tên tôi là Lan."
            },
            {
              "en": "Nice to meet you.",
              "vi": "Rất vui được gặp bạn."
            },
            {
              "en": "I am from Vietnam.",
              "vi": "Tôi đến từ Việt Nam."
            }
          ]
        }
      ],
