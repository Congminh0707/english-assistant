{
  "name": "english-assistant",
  "version": "1.1.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "Minh Ngo",
  "license": "MIT",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "release:win": "npm run build && electron-builder --win --publish always",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "sprites:characters": "node scripts/sprites/make-characters.mjs",
    "sprites:icon": "node scripts/sprites/make-icon.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:fetch": "tsx scripts/content/fetch.ts",
    "content:normalize": "tsx scripts/content/normalize.ts",
    "content:level": "tsx scripts/content/level.ts",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:build": "tsx scripts/content/build.ts",
    "content:lookup": "tsx scripts/content/lookup.ts",
    "content:typecheck": "tsc --noEmit -p scripts/content/tsconfig.json",
    "content:enrich": "tsx scripts/content/enrich.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "4.3.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "koffi": "^3.3.3",
    "kokoro-js": "1.2.1",
    "onnxruntime-node": "1.30.0",
    "phonemizer": "1.2.1",
    "pinia": "^4.1.0",
    "ts-fsrs": "^5.4.2",
    "vue-i18n": "^11.4.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@breezystack/lamejs": "^1.2.7",
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "seek-bzip": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "volta": {
    "node": "22.23.3",
    "pnpm": "12.14.0"
  }
}
